# Railway injeta PORT automaticamente.
NODE_ENV=production
DATABASE_URL=postgresql://usuario:senha@host:5432/claria
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
APP_NAME=Claria
APP_URL=https://seu-app.up.railway.app

# IA é opcional nesta v0.1. Sem chave, o app funciona com regras + revisão manual.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_ENABLED=false

# Segurança/arquivos
MAX_UPLOAD_MB=20
STORE_ORIGINAL_FILES=false
