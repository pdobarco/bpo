# Railway injeta PORT automaticamente.
NODE_ENV=production
# Use no Railway a mesma DATABASE_URL do PostgreSQL já existente.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco_existente

# Acesso master inicial
MASTER_EMAIL=thomas.muller@bateriasmoura.com
# Defina uma senha forte (mínimo 8 caracteres) nas Variables do Railway.
MASTER_INITIAL_PASSWORD=defina-uma-senha-forte
SESSION_DAYS=30

# GPT-5.6 Luna
AI_ENABLED=true
OPENAI_API_KEY=cole-sua-chave-aqui
OPENAI_MODEL=gpt-5.6-luna
AI_MAX_BATCH=40
AI_FILE_MAX_CHARS=30000

# Upload
MAX_UPLOAD_MB=25

# Segurança (v0.8.7)
# Origens extras autorizadas a chamar a API (separadas por vírgula). Vazio = somente a própria origem.
CORS_ORIGINS=
# Saltos de proxy confiáveis para identificar o IP real (Railway = 1). Use "false" sem proxy.
TRUST_PROXY=1
# Tentativas de login por IP por minuto.
LOGIN_RATE_LIMIT=10
LOG_LEVEL=info
